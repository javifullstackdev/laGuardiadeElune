# Copy to .env.prod on the VPS (never commit .env.prod)

# ── Site ──────────────────────────────────────────────
SITE_URL=https://www.laguardiadeelune.com
# Absolute origin for /static uploads (must match the public domain)
PUBLIC_BASE_URL=https://www.laguardiadeelune.com
ACME_EMAIL=tu-email@ejemplo.com

# ── Database ──────────────────────────────────────────
# Do NOT set DATABASE_URL here — compose injects @db:5432
# DB_PASSWORD must be URL-safe (letters/digits/_- only; no @ : # / ? %)
DB_USER=laguardia
DB_PASSWORD=CHANGE_ME_LONG_RANDOM
DB_NAME=laguardiadeelune

# ── Auth ──────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_32+_RANDOM_BYTES
CORS_ORIGINS=https://www.laguardiadeelune.com,https://laguardiadeelune.com

# Discord OAuth + bot
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://www.laguardiadeelune.com/api/auth/discord/callback
DISCORD_GUILD_ID=
DISCORD_TOKEN=

# Blizzard OAuth
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
BLIZZARD_REGION=eu
BLIZZARD_REDIRECT_URI=https://www.laguardiadeelune.com/api/auth/blizzard/callback
# Hermandad cuyo roster cuenta para la regla de 3 de 5
GUILD_REALM=dun-modr
GUILD_SLUG=la-guardia-de-elune
# Revisión cada 6 h (M+, temporadas, títulos). Con ENV=production ya va encendida.
# SCHEDULER_ENABLED=1
# SYNC_INTERVAL_HOURS=6
